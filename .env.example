# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8080

# MongoDB connection string. In production this may be an sm:// Secret Manager reference.
MONGODB_URI=mongodb://127.0.0.1:27017/buddy

# JWT signing secret (min 16 chars). In production use an sm:// Secret Manager reference.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

LOG_LEVEL=info
